year <- meta[["Config/BIOSZEN/CitationYear"]]
concept_doi <- meta[["Config/BIOSZEN/ConceptDOI"]]
rrid <- paste0("RRID:", sub("^RRID:", "", meta[["Config/BIOSZEN/RRID"]], ignore.case = TRUE))

bibentry(
  bibtype = "Manual",
  title = "BIOSZEN",
  author = person(
    given = "Benjamín",
    family = "Szenfeld",
    comment = c(ORCID = "0009-0003-4702-4149")
  ),
  year = year,
  doi = concept_doi,
  url = paste0("https://doi.org/", concept_doi),
  note = paste("R package and Shiny application; Research Resource Identifier:", rrid),
  textVersion = paste(
    paste0("Szenfeld, B. (", year, "). BIOSZEN. Zenodo. https://doi.org/", concept_doi),
    paste("Research Resource Identifier:", rrid),
    sep = "\n"
  )
)
